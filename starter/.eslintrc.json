{
  "root": true,
  "extends": ["airbnb-base"],
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": false,
    "sourceType": "module"
  },
  "env": { "browser": true, "es2022": true },
  "rules": {
    "import/extensions": ["error", "always"],
    "no-param-reassign": ["error", { "props": false }]
  }
}
